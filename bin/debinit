#!/bin/sh
# debinit: DebDroid bootstrap script
# Automatically applies commonly-used patches and fixes

# Check if the user has root permissions 
if [ "$(id -u)" -ne 0 ]; then
    echo "$0: Missing required super-user permissions."
    exit 1
fi

# Logs script activity to /tmp/debinit.log, without hiding how it went
# NOTE: The exit status has to survive the pipe. A pipeline reports its last
#       command, so this used to return tee's status, which is success almost
#       always. That matters because the manager runs this as
#       "sh debinit && <the user's command>": with the failure swallowed, the
#       "&&" never held anything back and a broken bootstrap carried straight
#       on to the user's command.
# NOTE: POSIX has no PIPESTATUS, and the shebang does not apply here because
#       both call sites run this as "sh /debdroid/bin/debinit", so the status
#       goes through a file instead.
if [ -z "$DEBDROID_INIT" ]; then
  export DEBDROID_INIT=1
  exec sh -c '
    { "$0" "$@" 2>&1; echo $? > /tmp/debinit.status; } | tee /tmp/debinit.log
    read -r debinit_status < /tmp/debinit.status || debinit_status=1
    exit "$debinit_status"
  ' "$0" "$@"
fi

# Loads the debdroid environment file
# shellcheck disable=SC1091
. /sdcard/debdroid/environment

if ! getent group inet > /dev/null 2>&1; then
    groupadd -g 3003 inet
fi

# Fixes apt's networking issue
if ! id -nG _apt | grep -qw inet; then
    usermod -g inet _apt
fi

# Creates missing runtime folders
for dir in /run/sshd /run/dbus; do
    if [ ! -d "$dir" ]; then
        mkdir -p "$dir"
        chmod 755 "$dir"
    fi
done

if command -v dbus-daemon >/dev/null 2>&1; then
    rm -f /run/dbus/pid
    dbus-daemon --system --fork
else
    echo "$0: Failed to start the system DBus, dbus-daemon is not installed."
    echo "Install the \"dbus-x11\" package and restart the environment."
fi
